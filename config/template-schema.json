{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NovelGameTemplate",
  "description": "玩法模板配置。更换模板时新增/修改本文件与对应内容包，不改引擎核心。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "engine",
    "attributes",
    "stages",
    "endings",
    "save"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "soulTest": {
      "type": "object",
      "description": "2026-09-07 定版预留：魂性问心题库与第一世角色推荐映射配置；旧模板可不带，第一版仍可直接开始单世。"
    },
    "cycle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "livesPerCycle": {
          "type": "integer",
          "minimum": 1
        },
        "recapAtLife": {
          "type": "integer",
          "minimum": 1
        },
        "archiveFromLife": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "stageSequence",
        "eventsPerStage",
        "maxEvents"
      ],
      "properties": {
        "mode": {
          "const": "event-choice"
        },
        "stageSequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eventsPerStage": {
          "type": "object",
          "description": "每个阶段的事件抽取数量。min 用于条件不足时保底，max 为实际抽取上限。",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1
        },
        "weightedDraw": {
          "type": "boolean",
          "default": true
        },
        "noRepeatWithinRun": {
          "type": "boolean",
          "default": true
        },
        "allowRepeatAcrossRuns": {
          "type": "boolean",
          "default": true
        },
        "interlude": {
          "type": [
            "object",
            "null"
          ],
          "description": "阶段切换时的结算文案与展示配置。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "template": {
              "type": "string"
            }
          }
        },
        "age": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "defaultTimeAdvanceYears": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "score": {
      "type": "object",
      "description": "精彩度评分与来世传承配置。",
      "additionalProperties": false,
      "required": [
        "enabled",
        "label",
        "range"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "endingBands": {
          "type": "array",
          "description": "R1 结局分档：按结局 id 给出低值 min 与高值 max，与运行时 endings 键一一对应；缺省时引擎使用内置 G01-G08/fallback 档位。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endingId",
              "min",
              "max"
            ],
            "properties": {
              "endingId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "description": "R1 连贯性证据分：高风险成功、关键解锁成功、高风险失败三组 points/cap，以及 totalCap；缺省使用 2/6、1/4、1/2、12。",
          "additionalProperties": false,
          "properties": {
            "riskySuccess": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "cap": {
                  "type": "number"
                }
              }
            },
            "unlockFlagSuccess": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "cap": {
                  "type": "number"
                }
              }
            },
            "dramaticFailure": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "number"
                },
                "cap": {
                  "type": "number"
                }
              }
            },
            "totalCap": {
              "type": "number"
            }
          }
        },
        "base": {
          "type": "number",
          "description": "deprecated：0.3.0 旧评分公式基础分，R1 起不再消费；旧模板/旧存档只读保留。"
        },
        "delta": {
          "type": "object",
          "description": "deprecated：0.3.0 旧评分公式选项增量，R1 起不再消费；旧模板/旧存档只读保留。",
          "additionalProperties": {
            "type": "number"
          }
        },
        "soulPoints": {
          "type": "object",
          "description": "2026-09-07 定版预留：轮回点数换算与上限（每 10 分精彩度 ≈ 1 点等）；为同一系统轮回结算功能，不是第二系统。"
        },
        "soulAssets": {
          "type": "object",
          "description": "2026-09-07 定版预留：可加点灵魂资产（资质/悟性/血脉）的档位与下一世生效规则；为同一系统轮回结算功能。"
        },
        "endingBonus": {
          "type": "object",
          "description": "deprecated：0.3.0 旧评分公式结局加成，R1 起不再消费；旧模板/旧存档只读保留。",
          "additionalProperties": {
            "type": "number"
          }
        },
        "reincarnation": {
          "type": "object",
          "description": "deprecated：0.3.0 旧 30% 自动继承配置，R1 起不再消费；旧模板/旧存档只读保留。",
          "additionalProperties": false,
          "required": [
            "enabled",
            "label",
            "inheritAttrs",
            "cap",
            "rate"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "inheritAttrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cap": {
              "type": "number"
            },
            "rate": {
              "type": "number"
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "realm",
            "story",
            "living",
            "legacy"
          ],
          "properties": {
            "realm": {
              "type": "number",
              "minimum": 0,
              "maximum": 250
            },
            "story": {
              "type": "number",
              "minimum": 0,
              "maximum": 250
            },
            "living": {
              "type": "number",
              "minimum": 0,
              "maximum": 250
            },
            "legacy": {
              "type": "number",
              "minimum": 0,
              "maximum": 250
            }
          },
          "description": "R2：模板只表达四段上限，运行时实际值写入 score_detail.sections。"
        }
      }
    },
    "attributes": {
      "type": "object",
      "description": "属性定义。键为属性 id，值为展示与数值配置。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "init",
          "min",
          "max",
          "group"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "init": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "group": {
            "enum": [
              "growth",
              "resource",
              "state",
              "custom"
            ]
          },
          "displayOrder": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          },
          "decayOnZero": {
            "type": "boolean"
          },
          "zeroMessage": {
            "type": "string"
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "description": "阶段定义。键为阶段 id，值包含标题、说明、权重与可选条件。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "interlude": {
            "type": "string"
          },
          "minEvents": {
            "type": "integer",
            "minimum": 1
          },
          "maxEvents": {
            "type": "integer",
            "minimum": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "endings": {
      "type": "object",
      "description": "结局判定配置。顺序即优先级：先满足先命中。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description",
          "conditions"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "any",
                  "all",
                  "threshold",
                  "flag",
                  "fallback"
                ]
              },
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attribute",
                    "op",
                    "value"
                  ],
                  "properties": {
                    "attribute": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "gte",
                        "gt",
                        "lte",
                        "lt",
                        "eq",
                        "between"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  }
                }
              },
              "requiredFlags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missingFlags": {
                "type": "array",
                "description": "必须缺失的标记；命中结局条件时这些标记不能存在。",
                "items": {
                  "type": "string"
                }
              },
              "countOfThresholds": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              }
            }
          },
          "weight": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxHistory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxHistory": {
          "type": "integer",
          "minimum": 1
        },
        "autoSave": {
          "type": "boolean"
        },
        "storageKeyPrefix": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "页面文案与展示层配置，可被模板覆盖。",
      "properties": {
        "title": {
          "type": "string"
        },
        "startButton": {
          "type": "string"
        },
        "restartButton": {
          "type": "string"
        },
        "confirmFlagLabels": {
          "type": "object"
        },
        "showFlags": {
          "type": "boolean"
        }
      }
    },
    "learningSystem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxStageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "initialRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
