{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NovelGameTemplate",
  "description": "玩法模板配置。更换模板时新增/修改本文件与对应内容包，不改引擎核心。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "engine", "attributes", "stages", "endings", "save"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stageSequence", "eventsPerStage", "maxEvents"],
      "properties": {
        "mode": { "const": "event-choice" },
        "stageSequence": { "type": "array", "items": { "type": "string" } },
        "eventsPerStage": {
          "type": "object",
          "description": "每个阶段的事件抽取数量。min 用于条件不足时保底，max 为实际抽取上限。",
          "patternProperties": {
            "^.+$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "maxEvents": { "type": "integer", "minimum": 1 },
        "weightedDraw": { "type": "boolean", "default": true },
        "noRepeatWithinRun": { "type": "boolean", "default": true },
        "allowRepeatAcrossRuns": { "type": "boolean", "default": true },
        "interlude": {
          "type": ["object", "null"],
          "description": "阶段切换时的结算文案与展示配置。",
          "properties": {
            "enabled": { "type": "boolean" },
            "template": { "type": "string" }
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "description": "属性定义。键为属性 id，值为展示与数值配置。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "init", "min", "max", "group"],
        "properties": {
          "label": { "type": "string" },
          "init": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "group": { "enum": ["growth", "resource", "state", "custom"] },
          "displayOrder": { "type": "integer" },
          "color": { "type": "string" },
          "decayOnZero": { "type": "boolean" },
          "zeroMessage": { "type": "string" }
        }
      }
    },
    "stages": {
      "type": "object",
      "description": "阶段定义。键为阶段 id，值包含标题、说明、权重与可选条件。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "interlude": { "type": "string" },
          "minEvents": { "type": "integer", "minimum": 1 },
          "maxEvents": { "type": "integer", "minimum": 1 },
          "weight": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "endings": {
      "type": "object",
      "description": "结局判定配置。顺序即优先级：先满足先命中。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description", "conditions"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "tone": { "type": "string" },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["any", "all", "threshold", "flag", "fallback"] },
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attribute", "op", "value"],
                  "properties": {
                    "attribute": { "type": "string" },
                    "op": { "enum": ["gte", "gt", "lte", "lt", "eq", "between"] },
                    "value": { "type": "number" },
                    "min": { "type": "number" },
                    "max": { "type": "number" }
                  }
                }
              },
              "requiredFlags": { "type": "array", "items": { "type": "string" } },
              "countOfThresholds": { "type": "integer", "minimum": 1 },
              "description": { "type": "string" }
            }
          },
          "weight": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxHistory"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxHistory": { "type": "integer", "minimum": 1 },
        "autoSave": { "type": "boolean" },
        "storageKeyPrefix": { "type": "string" }
      }
    },
    "ui": {
      "type": "object",
      "description": "页面文案与展示层配置，可被模板覆盖。",
      "properties": {
        "title": { "type": "string" },
        "startButton": { "type": "string" },
        "restartButton": { "type": "string" },
        "confirmFlagLabels": { "type": "object" },
        "showFlags": { "type": "boolean" }
      }
    }
  }
}
