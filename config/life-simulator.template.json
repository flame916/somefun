      "min": 0,
      "max": 100,
      "group": "state",
      "displayOrder": 5,
      "color": "#3d6ea5",
      "zeroMessage": "理智已归零，你再也无法思考。"
    },
    "health": {
      "label": "健康",
      "init": 100,
      "min": 0,
      "max": 100,
      "group": "state",
      "displayOrder": 6,
      "color": "#3a8a6f",
      "zeroMessage": "健康已归零，你的身体撑不住了。"
    }
  },
  "score": {
    "enabled": true,
    "label": "精彩度",
    "range": {
      "min": 0,
      "max": 100
    },
    "base": 40,
    "delta": {
      "risk": 8,
      "success": 4,
      "sacrifice": 3,
      "custom": 2,
      "safe": 1
    },
    "endingBonus": {
      "bright": 20,
      "warm": 12,
      "dark": 5,
      "neutral": 3
    },
    "reincarnation": {
      "enabled": true,
      "label": "来世传承",
      "inheritAttrs": ["wealth", "power", "fame", "bond"],
      "cap": 12,
      "rate": 0.3
    }
  },
  "stages": {
    "youth": {
      "label": "第一幕 · 入局",
      "description": "你刚踏入江湖，一切都在试探你的分寸。",
      "interlude": "少年岁月转瞬即逝，你已长出第一副筋骨。",
      "minEvents": 4,
      "maxEvents": 5
    },
    "prime": {
      "label": "第二幕 · 抉择",
      "description": "名声、责任与野心同时找上门来。",
      "interlude": "正当壮年，你的名字开始被人提起。",
      "minEvents": 5,
      "maxEvents": 6
    },
    "late": {
      "label": "第三幕 · 收束",
      "description": "风浪渐渐平息，命运到了清点的时刻。",
      "interlude": "暮年将至，你开始回望走过的路。",
      "minEvents": 4,
      "maxEvents": 5
    }
  },
  "endings": {
    "ending_collapse": {
      "label": "抱憾退场",
      "description": "理智或健康归零时强制触发。",
      "tone": "dark",
