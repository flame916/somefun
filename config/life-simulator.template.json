  "stages": {
    "act1": {
      "label": "第一幕 · 死而复生",
      "description": "你在荒村尸堆中醒来，脑中多了一道来历不明的声响，四周的妖兽正循着血腥味靠近。",
      "interlude": "第一幕结束：你活过了最初那场死局，也第一次听见了命运的节拍。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act2": {
      "label": "第二幕 · 小村风云",
      "description": "你带着新得的底气回到人间，藏宝阁、山村与故人的名字一同找上门来。",
      "interlude": "第二幕结束：你护住了脚下的土地，也第一次有了不愿放手的人。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act3": {
      "label": "第三幕 · 五国棋盘",
      "description": "旧日的身份被掀开一角，五国宗门在暗处落子，你的名字被写上了棋盘。",
      "interlude": "第三幕结束：你站在棋局中央，终于看清复仇与退让都只是两条不同的路。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act4": {
      "label": "第四幕 · 炸天帮崛起",
      "description": "乱世里人不如草芥，你决定把散落在五国的故人收拢成一方自己的旗帜。",
      "interlude": "第四幕结束：帮派立起来了，你的肩上从此多了一群人的生死。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act5": {
      "label": "第五幕 · 乱世将临",
      "description": "五行山深处传出异动，五国边境同时燃起烽烟，有人说是邪魔在暗中推着这盘棋。",
      "interlude": "第五幕结束：你探过深渊也吹过反攻的号角，乱世的轮廓第一次清晰起来。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act6": {
      "label": "第六幕 · 回地球",
      "description": "天门洞开的一瞬，你看见了熟悉的水泥森林：那是你上一世出生、又早已遗忘的故乡。",
      "interlude": "第六幕结束：两个世界都向你伸手，你开始计算哪一边更需要你。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act7": {
      "label": "第七幕 · 仙云洲风暴",
      "description": "永夜殿的魔核流出域外，仙云洲的宗门却互相指控，一场针对天门的阴谋正等着被揭穿。",
      "interlude": "第七幕结束：真相压过了流言，你的战力也走到了此世的最顶端。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    },
    "act8": {
      "label": "第八幕 · 神域之门",
      "description": "中央天门悬于云端，四帝环伺，小柔被困在门后的牢笼里。这是此世最后一次选择。",
      "interlude": "第八幕结束：门已开，此生的答卷也到了落笔之时。",
      "minEvents": 2,
      "maxEvents": 2,
      "weight": 100
    }
  },
