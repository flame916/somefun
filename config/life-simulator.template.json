        "mode": "any",
        "thresholds": [
          { "attribute": "sanity", "op": "lte", "value": 0 },
          { "attribute": "health", "op": "lte", "value": 0 }
        ]
      }
    },
    "ending_balanced": {
      "label": "圆满谢幕",
