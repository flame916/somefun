{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NovelGameContent",
  "description": "内容包配置：事件、结局卡、可选的占位标记。事件与结局均支持条件和随机抽取。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meta",
    "events",
    "endingCards"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "soulTest": {
      "type": "object",
      "description": "2026-09-07 定版预留：魂性问心题库与第一世角色推荐映射（5-8 题）。旧内容包可不带，引擎按单世通用运行。"
    },
    "characterBiographies": {
      "type": "object",
      "description": "2026-09-07 定版预留：首批 3-5 个小角色人物志（每角色 6-10 个关键切片），独立于主角十世。旧内容包可不带。"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source",
        "isPlaceholder"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "isPlaceholder": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "novelTitle": {
          "type": "string"
        },
        "contentRoute": {
          "enum": [
            "A",
            "B",
            "C",
            "none"
          ]
        }
      }
    },
    "activePractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowId", "defaultDaoId", "maxActionSlots", "breakthroughTimingId"],
      "properties": {
        "windowId": { "const": "preparation_window_01" },
        "defaultDaoId": { "enum": ["DAO01", "DAO02"] },
        "startMedicine": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maxActionSlots": { "const": 3 },
        "breakthroughTimingId": { "const": "breakthrough_timing_01" }
      }
    },
    "optionFeedback": {
      "type": "object",
      "description": "R3.1 选项级即时回执与稳定状态 ID；按事件 ID 与选项索引对齐，由运行时合并到 options。",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resultText", "failureText", "bridgeText"],
          "properties": {
            "resultText": { "type": "string" },
            "failureText": { "type": "string" },
            "bridgeText": { "type": "string" },
            "unlockFlag": { "type": "string" },
            "failureUnlockFlag": { "type": "string" }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "stage",
          "options",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "minimum": 0
          },
          "isPlaceholder": {
            "type": "boolean",
            "default": true
          },
          "sceneDuration": {
            "type": "string",
            "minLength": 1,
            "description": "R3：纯呈现时长；不得改变 age/remainingYears/worldYear。"
          },
          "lifeAdvance": {
            "$ref": "#/definitions/lifeAdvance"
          },
          "resultText": {
            "type": "string",
            "minLength": 1,
            "description": "R3：事件级成功结果正文。"
          },
          "failureText": {
            "type": "string",
            "minLength": 1,
            "description": "R3：事件级失败结果正文。"
          },
          "bridgeText": {
            "type": "string",
            "minLength": 1,
            "description": "R3：同幕下一事件前的具体承接。"
          },
          "timeBeats": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/timeBeat"
            },
            "description": "R3：有序时间叙事节拍；只用于呈现，不改账本。"
          },
          "nextEventTrigger": {
            "type": "string",
            "minLength": 1,
            "description": "R3：下一事件现在发生的原因。"
          },
          "personLedgerEntry": {
            "$ref": "#/definitions/personLedgerEntry"
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minAge": {
                "type": "number"
              },
              "requiredAttribute": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              "requiredFlag": {
                "type": "string"
              },
              "requiredAnyFlag": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiredAllFlags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "powerSource": {
            "type": "string",
            "description": "R2 生效：本世力量来源。system 只绑定第一世；旧事件不带时按单世通用。"
          },
          "requiresPowerSource": {
            "type": [
              "string",
              "null"
            ],
            "description": "R2 生效：事件要求的力量来源；null 表示不限制。"
          },
          "fateChain": {
            "type": "string",
            "description": "2026-09-07 定版预留：所属命运链 id（守护/复仇/证道/传承等）。"
          },
          "fateInstance": {
            "type": "string",
            "description": "2026-09-07 定版预留：命运链在当前纪元的实例 id；跨世同一链文本不同、逻辑一致。"
          },
          "fateChainStage": {
            "type": "string",
            "description": "2026-09-07 定版预留：孕育/浮现/激化/转机/终章/回响等阶段，与 fateChain 配套。"
          },
          "memoryFragment": {
            "type": "string",
            "description": "2026-09-07 定版预留：觉醒时揭示的记忆碎片内容/来源。觉醒前不暴露完整前世。"
          },
          "awakenTrigger": {
            "type": "string",
            "description": "2026-09-07 定版预留：碎片觉醒触发条件；平时只以梦/既视感/直觉呈现。"
          },
          "unfinishedBusiness": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "2026-09-07 定版预留：本事件涉及的可承接未竟之事（情债/仇债/恩债等）。因果稀疏化，活跃上限 3-5 条，玩家可接/放。"
          },
          "grudgeAnchor": {
            "type": "string",
            "description": "2026-09-07 定版预留：血仇/执念锚点 id，指向 fateChain 跨世承接。"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "effects"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "effects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "successRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "failureEffects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "resultText": {
                  "type": "string",
                  "description": "R3.1 选项级成功结果；优先于事件级 resultText。"
                },
                "failureText": {
                  "type": "string",
                  "description": "R3.1 选项级失败结果；优先于事件级 failureText。"
                },
                "bridgeText": {
                  "type": "string",
                  "description": "R3.1 选项级承接；优先于事件级 bridgeText。"
                },
                "failureUnlockFlag": {
                  "type": ["string", "null"],
                  "description": "R3.1 失败侧稳定分支旗标。"
                },
                "nextEvent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unlockFlag": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "riskTag": {
                  "enum": [
                    "safe",
                    "risky",
                    "sacrifice",
                    "custom"
                  ]
                },
                "style": {
                  "type": "string",
                  "description": "2026-09-07 定版预留：本选项行事风格 aggressive/stealth/diplomatic/sacrifice/custom 等，与魂性问心结果同语言。"
                },
                "counterStyle": {
                  "type": "string",
                  "description": "2026-09-07 定版预留：克制本选项的风格，用于互克判定。"
                },
                "beats": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "2026-09-07 定版预留：本选项的次数/节拍权重，用于互克与倾向玩法。"
                },
                "losesTo": {
                  "type": "string",
                  "description": "2026-09-07 定版预留：被击败/克制的目标（另一选项 id 或 style）。"
                },
                "successRateBase": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "2026-09-07 定版预留：互克判定前基础成功率；运行时仍使用 successRate，生效前需 B 复跑校验。"
                },
                "successRateShift": {
                  "type": "number",
                  "description": "2026-09-07 定版预留：互克判定后的成功率偏移；运行时仍使用 successRate。"
                },
                "semantic": {
                  "enum": [
                    "safe",
                    "risky",
                    "sacrifice",
                    "custom"
                  ],
                  "description": "R2 生效：sacrifice 成败两侧都不得给正修为。"
                },
                "d20": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "target"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "target": {
                      "enum": [
                        7,
                        10,
                        13,
                        16,
                        19
                      ]
                    },
                    "kind": {
                      "enum": [
                        "event",
                        "breakthrough",
                        "study",
                        "sacrifice",
                        "karma"
                      ]
                    },
                    "modifier": {
                      "type": "number"
                    },
                    "modifierSource": {
                      "enum": [
                        "none",
                        "aptitude",
                        "fortune"
                      ]
                    }
                  },
                  "description": "R2 生效：d20 检定，成功为 roll + modifier >= target；1 大凶、20 大成功。"
                },
                "unfinishedBusiness": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "eventWindow": {
            "$ref": "#/definitions/eventWindow"
          }
        }
      }
    },
    "endingCards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "isPlaceholder": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "definitions": {
    "timeBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "text"
      ],
      "properties": {
        "at": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifeAdvance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "months",
        "source",
        "reason",
        "basis"
      ],
      "properties": {
        "months": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "const": "event"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "personLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "slice"
      ],
      "properties": {
        "character": {
          "type": "string",
          "minLength": 1
        },
        "slice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "eventWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "monthsFromNow",
        "announceAfterEvent",
        "resolveAtEvent",
        "karmaOnAvoid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "monthsFromNow": {
          "type": "number",
          "minimum": 0
        },
        "announceAfterEvent": {
          "type": "string",
          "minLength": 1
        },
        "resolveAtEvent": {
          "type": "string",
          "minLength": 1
        },
        "karmaOnAvoid": {
          "type": "boolean"
        }
      }
    }
  }
}
